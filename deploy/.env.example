# 复制为 deploy/.env，按实际环境修改后：
#   set -a; . deploy/.env; set +a
#   docker stack deploy --with-registry-auth -c deploy/stack.yml cdwy
# 密码、JWT 密钥不写在这里，见 deploy/README.md 第 3 节 docker secret。

# 镜像（本地构建后推送到镜像仓库，或在放置节点上 docker load）
RBAC_BACKEND_IMAGE=cdwy/rbac-backend:second-review
RBAC_FRONTEND_IMAGE=cdwy/rbac-frontend:second-review
COURSE_BACKEND_IMAGE=cdwy/course-backend:second-review
COURSE_FRONTEND_IMAGE=cdwy/course-frontend:second-review

# 对外端口（Swarm ingress）
RBAC_HTTP_PORT=18080
COURSE_HTTP_PORT=18090

# 两种设计实现：structured | ddd
RBAC_BACKEND_STRATEGY=structured
COURSE_BACKEND_STRATEGY=structured

# 数据库（集群内可达的 MySQL；两个系统各用独立库与最小权限账号）
DB_HOST=lab_mysql
DB_PORT=3306
RBAC_DB_NAME=cdwy_rbac
RBAC_DB_USER=cdwy_rbac
COURSE_DB_NAME=course_project
COURSE_DB_USER=course_project

# 首次启动创建的权限系统管理员登录名（密码在 secret rbac_bootstrap_password）
RBAC_BOOTSTRAP_USERNAME=admin

# 课程系统在权限系统中登记的应用编码
COURSE_APP_CODE=cpm

# 日志：前端切换菜单后，用 docker service logs -f cdwy_rbac-backend 查看 [menu=...] 日志
RBAC_LOG_LEVEL=INFO
RBAC_LOG_LEVEL_INFRASTRUCTURE=INFO
COURSE_LOG_LEVEL=DEBUG
