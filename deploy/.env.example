# 权限系统 stack 的部署变量。复制为 .env（不提交），按实际环境修改后在管理节点执行：
#   (set -a; . ./.env; set +a; docker stack deploy --resolve-image never -c stack.yml cdwy)
# 密码与密钥不写在这里，见 deploy/README.md「准备数据库与 docker secret」。

# 镜像：在权限系统节点上用 deploy/permission/package-images.sh 打的包构建，标签是提交号
RBAC_BACKEND_IMAGE=cdwy/rbac-backend:<提交号>
RBAC_FRONTEND_IMAGE=cdwy/rbac-frontend:<提交号>

# 两种设计实现：structured | ddd
RBAC_BACKEND_STRATEGY=structured

# 对外端口。host 模式只占用权限系统节点（标签 cdwy.rbac=true）的端口
RBAC_HTTP_PORT=80
RBAC_PUBLISH_MODE=host

# 数据库：javaee-proxy 网络上的 lab_mysql（别名 mysql）
DB_HOST=mysql
DB_PORT=3306
RBAC_DB_NAME=cdwy_rbac
RBAC_DB_USER=cdwy_rbac
RBAC_DB_POOL_SIZE=5

# 首次启动创建的管理员登录名（密码在 secret cdwy_rbac_bootstrap_password_v1）
RBAC_BOOTSTRAP_USERNAME=admin

# 课程前端的源地址（协议 + 主机 + 端口），浏览器从这里直连统一身份接口
RBAC_CORS_ALLOWED_ORIGINS=http://<课程前端公网地址>

# 菜单切换日志：docker service logs -f cdwy_rbac-backend 中的 [menu=...]
RBAC_LOG_LEVEL=INFO
RBAC_LOG_LEVEL_INFRASTRUCTURE=INFO
RBAC_BACKEND_MEMORY_LIMIT=640M
RBAC_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70
