# 权限系统前端镜像：Nginx 托管 Vue 构建产物（/ui/），并把 /api/ 反向代理到 rbac-backend。
# 先执行 frontend 的 npm run build（产物在 src/main/resources/static/ui），再在仓库根目录：
# docker build -f deploy/permission/Dockerfile.frontend -t <镜像名> .
ARG NGINX_IMAGE=swr.cn-north-4.myhuaweicloud.com/oomall-javaee/nginx:stable-alpine
FROM ${NGINX_IMAGE}

COPY src/main/resources/static/ui /usr/share/nginx/html/ui
COPY deploy/permission/nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
