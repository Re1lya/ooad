diff --git a/web/src/views/LoginView.vue b/web/src/views/LoginView.vue
new file mode 100644
index 0000000..6edc9dd
--- /dev/null
+++ b/web/src/views/LoginView.vue
@@ -0,0 +1,65 @@
+<script setup lang="ts">
+import { shallowRef } from 'vue'
+import { useRoute, useRouter } from 'vue-router'
+import { loginWithIdentity } from '@/auth/identity-session'
+
+const route = useRoute()
+const router = useRouter()
+const username = shallowRef('')
+const password = shallowRef('')
+const busy = shallowRef(false)
+const error = shallowRef<string | null>(null)
+
+async function submit() {
+  if (busy.value) {
+    return
+  }
+  busy.value = true
+  error.value = null
+  try {
+    await loginWithIdentity(username.value.trim(), password.value)
+    password.value = ''
+    const redirect = typeof route.query.redirect === 'string' && route.query.redirect.startsWith('/')
+      ? route.query.redirect
+      : '/'
+    await router.replace(redirect)
+  } catch (cause) {
+    error.value = cause instanceof Error ? cause.message : '登录失败，请稍后重试。'
+  } finally {
+    busy.value = false
+  }
+}
+</script>
+
+<template>
+  <main class="entry-shell">
+    <section class="entry-panel" aria-labelledby="login-title">
+      <header class="entry-header">
+        <p class="entry-brand">课程项目</p>
+        <p class="entry-kicker">统一身份登录</p>
+      </header>
+
+      <div class="entry-intro">
+        <h1 id="login-title" class="entry-title">使用统一身份账号登录</h1>
+        <p class="entry-copy">账号、角色和菜单权限由 Cdwy 统一权限管理系统维护，本系统不保存密码。</p>
+      </div>
+
+      <form class="mt-6 grid gap-3" @submit.prevent="submit">
+        <label class="grid gap-1 text-[13px] text-ios-secondary">
+          登录名
+          <input v-model="username" name="username" autocomplete="username" required maxlength="64" class="rounded-[10px] border border-ios-separator bg-white px-3 py-2 text-[15px] text-black">
+        </label>
+        <label class="grid gap-1 text-[13px] text-ios-secondary">
+          密码
+          <input v-model="password" name="password" type="password" autocomplete="current-password" required maxlength="72" class="rounded-[10px] border border-ios-separator bg-white px-3 py-2 text-[15px] text-black">
+        </label>
+        <p v-if="error" role="alert" class="text-[13px] text-red-600">{{ error }}</p>
+        <button type="submit" :disabled="busy" class="mt-2 rounded-[10px] bg-black px-4 py-2.5 text-[15px] font-medium text-white disabled:opacity-50">
+          {{ busy ? '正在登录…' : '登录' }}
+        </button>
+      </form>
+
+      <p class="entry-footnote">令牌只保存在本浏览器，退出后需要重新登录。</p>
+    </section>
+  </main>
+</template>
