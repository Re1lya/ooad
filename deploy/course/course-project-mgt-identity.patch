diff --git a/web/src/auth/identity-session.ts b/web/src/auth/identity-session.ts
new file mode 100644
index 0000000..2f6e12a
--- /dev/null
+++ b/web/src/auth/identity-session.ts
@@ -0,0 +1,52 @@
+import type { Router } from 'vue-router'
+
+/**
+ * 统一身份登录会话（Cdwy 统一权限管理系统接入）。
+ *
+ * 课程系统不保存账号和密码：登录页直接调用统一权限管理系统的登录 API，
+ * 拿到的 JWT 存入 cpm.accessToken，之后所有课程后端请求都携带它；
+ * 课程后端再用同一个令牌向统一权限管理系统查询 /auth/me 取得角色与权限码。
+ */
+export const ACCESS_TOKEN_KEY = 'cpm.accessToken'
+export const IDENTITY_LOGIN_URL = import.meta.env.VITE_IDENTITY_LOGIN_URL ?? '/identity/api/auth/login'
+
+export function currentAccessToken(): string | null {
+  const mockToken = import.meta.env.DEV ? import.meta.env.VITE_MOCK_ACCESS_TOKEN : undefined
+  return localStorage.getItem(ACCESS_TOKEN_KEY) ?? mockToken ?? null
+}
+
+export interface IdentityLoginResult {
+  accessToken: string
+  tokenType: string
+  expiresIn: number
+}
+
+/** 调用统一权限管理系统登录 API，成功后保存令牌。 */
+export async function loginWithIdentity(username: string, password: string): Promise<IdentityLoginResult> {
+  const response = await fetch(IDENTITY_LOGIN_URL, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+    body: JSON.stringify({ username, password }),
+  })
+  const body = await response.json().catch(() => null)
+  if (!response.ok || !body?.accessToken) {
+    throw new Error(body?.message ?? '登录失败，请检查账号和密码。')
+  }
+  localStorage.setItem(ACCESS_TOKEN_KEY, body.accessToken)
+  return body as IdentityLoginResult
+}
+
+/** 清除本标签页保存的统一身份令牌。 */
+export function logoutIdentity() {
+  localStorage.removeItem(ACCESS_TOKEN_KEY)
+}
+
+/** 未登录时进入任何页面都先跳到统一身份登录页。 */
+export function installIdentityGuard(router: Router) {
+  router.beforeEach((to) => {
+    if (to.name === 'login' || currentAccessToken()) {
+      return true
+    }
+    return { name: 'login', query: { redirect: to.fullPath } }
+  })
+}
