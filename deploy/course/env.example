# 课程项目管理系统 stack 的部署变量（变量名沿用老师的 deploy/env.example）。
# 复制为 .env（不提交），按实际环境修改后在管理节点执行：
#   (set -a; . ./.env; set +a; docker stack deploy --resolve-image never -c stack.yml course-project)
# 数据库密码不写在这里：放在 docker secret course_project_db_password_v1。

# 镜像：在课程节点上用 deploy/course/package-images.sh 打的包构建，标签是老师仓库的提交号
BACKEND_IMAGE=course-mgt-backend:<老师仓库提交号>
FRONTEND_IMAGE=course-mgt-frontend:<老师仓库提交号>
BACKEND_STRATEGY=structured
BACKEND_MEMORY_LIMIT=768M
BACKEND_MEMORY_RESERVATION=256M
BACKEND_LOG_LEVEL_API=DEBUG
BACKEND_LOG_LEVEL_SERVICE=DEBUG
BACKEND_LOG_LEVEL_INFRASTRUCTURE=DEBUG
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75

# 对外端口。host 模式只占用课程节点（标签 cdwy.course=true）的端口
FRONTEND_HTTP_PORT=80
FRONTEND_PUBLISH_MODE=host
FRONTEND_MEMORY_LIMIT=256M
FRONTEND_MEMORY_RESERVATION=64M
FRONTEND_LOG_DIR=/root/logs/nginx

# 数据库：javaee-proxy 网络上的 lab_mysql（别名 mysql）
DB_HOST=mysql
DB_PORT=3306
DB_NAME=course_project
DB_USER=course_project
DB_POOL_SIZE=5

# 统一身份：权限系统后端在 javaee-proxy 网络上的地址 + 课程系统在权限系统中的应用编码
IDENTITY_BASE_URL=http://rbac-backend:18081/api/apps/course-project-management

# 课程后端只经前端 Nginx 同源访问；跨域来源只填课程前端自己的地址
CORS_ALLOWED_ORIGINS=http://<课程前端公网地址>
