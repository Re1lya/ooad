# 课程项目管理系统 stack 的部署变量（变量名沿用老师的 deploy/env.example）。
# 复制为 .env（不提交），按实际环境修改后在管理节点执行：
#   (set -a; . ./.env; set +a; docker stack deploy --resolve-image never -c stack.yml course-project)
# 数据库密码不写在这里：放在 docker secret course_project_db_password_v1。

# 后端：老师发布的镜像（老师 deploy/README.md 第 5 节“可以直接使用我编译好的镜像”），公开仓库，不需要登录。
# 按摘要固定：老师用同一标签重新推送时，部署不会悄悄换版本。在课程节点上先 docker pull 再部署。
BACKEND_IMAGE=swr.cn-north-4.myhuaweicloud.com/oomall-javaee/course-mgt-backend:0.0.1@sha256:88a476dfe43de8bbdcf6e009a5ab63631acb9ea365ec010b04d18f5e5791f67a
# 前端：用 deploy/course/package-frontend.sh 打的包在课程节点上构建，标签是老师仓库的提交号
# （权限系统改到 8080 后重新编译的版本另打标签 <提交号>-rbac8080）
FRONTEND_IMAGE=course-mgt-frontend:<老师仓库提交号>
# 设计路线：老师建议用 ddd（老师主要在 ddd 上测试）
BACKEND_STRATEGY=ddd
BACKEND_MEMORY_LIMIT=768M
BACKEND_MEMORY_RESERVATION=256M
BACKEND_LOG_LEVEL_API=DEBUG
BACKEND_LOG_LEVEL_SERVICE=DEBUG
BACKEND_LOG_LEVEL_INFRASTRUCTURE=DEBUG
# 登录服务所在的两个包：老师的登录服务在 DEBUG 级别会把含访问令牌的登录结果写进日志，保持 INFO
BACKEND_LOG_LEVEL_LOGIN=INFO
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75

# 对外端口：与老师一样用 ingress 发布，集群所有节点的 80 都进入课程系统
FRONTEND_HTTP_PORT=80
FRONTEND_MEMORY_LIMIT=256M
FRONTEND_MEMORY_RESERVATION=64M
FRONTEND_LOG_DIR=/root/logs/nginx

# 数据库：javaee-proxy 网络上的 lab_mysql（别名 mysql）
DB_HOST=mysql
DB_PORT=3306
DB_NAME=course_project
DB_USER=course_project
DB_POOL_SIZE=5

# 统一身份：权限系统后端在 javaee-proxy 网络上的地址 + 课程系统在权限系统中的应用编码
IDENTITY_BASE_URL=http://rbac-backend:18081/api/apps/course-project-management

# 课程后端只经前端 Nginx 同源访问；跨域来源只填课程前端自己的地址
CORS_ALLOWED_ORIGINS=http://<课程前端公网地址>

# Prometheus（与老师 deploy/env.example 相同）；抓取配置在 prometheus/prometheus.yml
PROMETHEUS_IMAGE=swr.cn-north-4.myhuaweicloud.com/oomall-javaee/prom/prometheus:latest
PROMETHEUS_RETENTION=15d
PROMETHEUS_HTTP_PORT=9090
PROMETHEUS_MEMORY_LIMIT=512M
PROMETHEUS_MEMORY_RESERVATION=128M
