@startuml package-overview
!include common.iuml
!pragma layout smetana
title 后端包图（先分层后分模块；service 层内并列 port / 结构化 / ddd 三条路线）
left to right direction

package "controller.*\n（HTTP 入口，按模块分包）" as C {
}
package "dto.* / vo.*\n（请求、响应对象）" as DTO {
}
package "config\n（安全、接口拦截、管理员引导）" as CFG {
}
package "service.port.*\n（用例端口 UseCase、数据 record、异常）" as PORT {
}
package "service.<模块>\n结构化事务脚本\nuser / role / permission / resource\nsystem / organization / rbac / auth\nidentity / importing" as STR {
}
package "service.structured.rbac\n结构化角色图算法" as STRG {
}
package "service.ddd.application.*\nDDD 应用服务（用例编排）" as APP {
}
package "service.ddd.domain.model\n实体、值对象、领域服务\nRoleGraph / AuthorizationSnapshot\nAccount / ManagedSystem / ProtectedResource" as DOM {
}
package "service.ddd.domain.repository\n领域仓储端口" as REPOPORT {
}
package "service.audit\n共享技术服务（审计）" as AUD {
}
package "infrastructure.persistence\nJPA 适配器（实现领域仓储端口）" as ADP {
}
package "infrastructure.security / logging\n路径匹配、凭证、当前操作人、分层日志" as INF {
}
package "repository.*\nSpring Data JPA" as REPO {
}
package "entity.*\nJPA 实体（12 张表）" as ENT {
}

C --> PORT : 只依赖用例端口
C --> DTO
CFG --> PORT
STR ..|> PORT : 实现（app.backend-strategy=structured）
APP ..|> PORT : 实现（app.backend-strategy=ddd）
STR --> STRG
STR --> REPO
STR --> AUD
APP --> DOM
APP --> REPOPORT
APP --> AUD
DOM --> PORT : 共享数据 record
ADP ..|> REPOPORT
ADP --> REPO
REPO --> ENT
AUD --> REPO
INF ..|> PORT
@enduml
