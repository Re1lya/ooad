<?xml version="1.0" encoding="UTF-8"?>
<!--
  logback 配置：控制台始终输出；swarm 配置下另写滚动文件。
  每行带请求号、前端菜单与操作人（MDC 由 RequestLoggingFilter / ApiAccessConfig 写入），
  前端切换菜单时可以在 docker service logs 或 logs/permission.log 中按 menu= 检索对应请求。
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="LOG_DIR" source="permission.logging.dir" defaultValue="logs"/>

    <property name="REQUEST_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5level [%X{requestId:--}] [menu=%X{menu:--}] [user=%X{userId:--}] %-40logger{40} : %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${REQUEST_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <springProfile name="swarm">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/permission.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/permission.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <maxFileSize>20MB</maxFileSize>
                <maxHistory>14</maxHistory>
                <totalSizeCap>500MB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${REQUEST_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <springProfile name="!swarm">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
